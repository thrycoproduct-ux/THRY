# THRY — copy to .env.local. Never commit .env.local.
# Use ONLY the new THRY Supabase + NEW Cloudflare account (never Hub / SSR Tex).

# Supabase
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_SERVICE_ROLE=
DATABASE_URL=

# Cloudflare R2 (S3-compatible) — NEW account only
NEXT_PUBLIC_S3_BUCKET=thry-cdn
NEXT_PUBLIC_S3_REGION=auto
S3_ENDPOINT=https://<NEW_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CDN_URL=

# Image delivery: legacy (raw R2) until thry-media /cdn is live; then cloudflare
NEXT_PUBLIC_IMAGE_DELIVERY_MODE=legacy
NEXT_PUBLIC_MEDIA_CDN_ORIGIN=https://media.thryco.com

# Site
NEXT_PUBLIC_SITE_URL=https://thryco.com
ORDER_ACCESS_SECRET=
CRON_SECRET=

# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — order confirmation emails (verify domain in Resend dashboard)
RESEND_API_KEY=
RESEND_FROM_EMAIL=THRY <orders@thryco.com>

# THRY media worker (browser PUT → R2; required for admin uploads on Vercel)
R2_MEDIA_PROXY_URL=https://media.thryco.com
R2_MEDIA_PROXY_SECRET=

# Stripe placeholders (unused if Cashfree/PhonePe only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECERT_KEY=whsec_placeholder

# SKIP_ENV_VALIDATION=true
